# VitalPulse — Variables d'environnement serveur (ne jamais commiter .env.local)

# Vision IA (Analyse photo de plats préparés & frigo + notes texte)
OPENAI_API_KEY=sk-proj-...
OPENAI_VISION_MODEL=gpt-4o-mini

# Web Push VAPID (Générer via: npx web-push generate-vapid-keys --json)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@maison-mercier.com

# Optionnel : URL de production Vercel pour le wrapper Android Capacitor
NEXT_PUBLIC_APP_URL=https://followeight.com
